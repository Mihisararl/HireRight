# Copy to .env.local for local development

# Backend API URL (include /api). On Vercel set the same key in Project → Environment Variables.
# Examples:
#   Local:  http://localhost:5000/api
#   Prod:   https://your-backend.onrender.com/api
REACT_APP_API_URL=http://localhost:5000/api

# Google OAuth Web client ID (optional)
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
